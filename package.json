{
  "name": "personal-homepage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.18.2"
  },
  "scripts": {
    "dev": "node --no-experimental-webstorage node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "check": "pnpm check:fast",
    "check:fast": "pnpm lint && pnpm typecheck",
    "ci:pr": "pnpm check:fast && pnpm build"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "next": "15.3.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "22.15.29",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.28.0",
    "eslint-config-next": "15.3.9",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "5.8.3"
  }
}
