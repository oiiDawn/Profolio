{
  "name": "personal-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": "^22.22.0 || ^24.0.0",
    "pnpm": ">=10.18.2"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "lint": "eslint app lib vite.config.ts react-router.config.ts eslint.config.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "pnpm check:fast",
    "check:fast": "pnpm lint && pnpm typecheck",
    "ci:pr": "pnpm check:fast && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@react-router/node": "8.3.0",
    "cracked-glass": "0.4.0",
